{
  "hooks": {
    "PreToolUse": [{"matcher": ".*", "hooks": [{
      "type": "command",
      "command": "${CLAUDE_PROJECT_DIR}/_local/venv/tools/Scripts/python.exe",
      "args": ["${CLAUDE_PROJECT_DIR}/scripts/usage_guard.py", "--provider", "claude"],
      "timeout": 10
    }]}],
    "PostToolUse": [{"matcher": ".*", "hooks": [{
      "type": "command",
      "command": "${CLAUDE_PROJECT_DIR}/_local/venv/tools/Scripts/python.exe",
      "args": ["${CLAUDE_PROJECT_DIR}/scripts/usage_guard.py", "--provider", "claude"],
      "timeout": 10
    }]}]
  },
  "statusLine": {
    "type": "command",
    "command": "\"${CLAUDE_PROJECT_DIR:-.}/_local/venv/tools/Scripts/python.exe\" \"${CLAUDE_PROJECT_DIR:-.}/scripts/statusline.py\""
  }
}
